:root {
  --color-bg: #e8f5e9;
  --color-text: #555;
  --color-footer: #fff;
  --color-primary: #009a63;
  --color-white: #fff;
  --font-family: Verdana, Geneva, sans-serif;
  --radius: 4px;
  --color-border: #ccc;
}

body {
  font-family: var(--font-family);
  background-color: var(--color-bg);
  color: var(--color-text);
  margin: 0;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 16px;
}

.header {
  background-color: var(--color-white);
}

.header__content {
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  display: flex;
}

.header__brand {
  align-items: center;
  gap: 12px;
  display: flex;
}

.header__logo-icon {
  background-color: var(--color-primary);
  width: 48px;
  height: 48px;
  color: var(--color-white);
  border-radius: 50%;
  justify-content: center;
  align-items: center;
  font-size: 18px;
  font-weight: bold;
  display: flex;
}

.header__logo-text {
  font-size: 20px;
  font-weight: bold;
}

.header__nav {
  align-items: center;
  gap: 32px;
  display: flex;
}

.header__nav-item {
  color: var(--color-text);
  cursor: pointer;
  padding: 4px 0;
  font-size: 14px;
  transition: color .3s;
}

.header__nav-item--active {
  color: var(--color-primary);
  font-weight: 600;
}

.header__nav-item:not(.header__nav-item--active):hover {
  color: var(--color-primary);
}

.account-icon {
  border: 2px solid var(--color-primary);
  cursor: pointer;
  border-radius: 50%;
  justify-content: center;
  align-items: center;
  width: 40px;
  height: 40px;
  transition: all .3s;
  display: flex;
}

.account-icon__inner {
  width: 16px;
  height: 16px;
  position: relative;
}

.account-icon__head {
  background-color: var(--color-primary);
  border-radius: 50%;
  width: 8px;
  height: 8px;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.account-icon__body {
  background-color: var(--color-primary);
  border-radius: 8px / 4px;
  width: 16px;
  height: 8px;
  position: absolute;
  bottom: 0;
  left: 0;
}

.account-icon:hover {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.account-icon:hover .account-icon__head, .account-icon:hover .account-icon__body {
  background-color: var(--color-white);
}

.main {
  justify-content: center;
  padding: 40px 0;
  display: flex;
}

.form {
  background-color: var(--color-white);
  border-radius: 8px;
  width: 100%;
  max-width: 600px;
  padding: 32px;
  box-shadow: 0 2px 8px #0000001a;
}

.form__title {
  margin-bottom: 24px;
  font-size: 24px;
  font-weight: bold;
}

.form__group {
  margin-bottom: 20px;
}

.form__label {
  margin-bottom: 8px;
  font-weight: bold;
  display: block;
}

.form__input, textarea.form__input {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  width: 100%;
  font-size: 14px;
  font-family: var(--font-family);
  box-sizing: border-box;
  padding: 10px 12px;
}

textarea.form__input {
  resize: vertical;
}

.form__select {
  color: var(--color-text);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  width: 100%;
  font-size: 14px;
  font-family: var(--font-family);
  box-sizing: border-box;
  appearance: none;
  background-image: url("data:image/svg+xml,%3Csvg width='12' height='8' viewBox='0 0 12 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L6 6L11 1' stroke='%236b7280' stroke-width='2'/%3E%3C/svg%3E");
  background-position: right 16px center;
  background-repeat: no-repeat;
  background-size: 12px;
  padding: 10px 12px;
}

.form__radio-group {
  flex-direction: column;
  gap: 8px;
  display: flex;
}

.form__radio-group label {
  font-size: 14px;
  font-weight: normal;
}

.form__actions {
  justify-content: flex-end;
  margin-top: 24px;
  display: flex;
}

.button {
  border: 2px solid var(--color-primary);
  background-color: var(--color-primary);
  color: var(--color-white);
  cursor: pointer;
  border-radius: 4px;
  padding: 10px 24px;
  font-size: 14px;
  font-weight: bold;
  transition: all .3s;
}

.button:hover {
  background-color: var(--color-white);
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.confirmation-message {
  background-color: var(--color-white);
  text-align: center;
  border-radius: 8px;
  max-width: 600px;
  margin: 0 auto;
  padding: 60px 20px;
  box-shadow: 0 2px 8px #0000001a;
}

.confirmation-message h1 {
  margin-bottom: 16px;
  font-size: 28px;
  font-weight: bold;
}

.confirmation-message p {
  margin-bottom: 8px;
  font-size: 16px;
}

.footer {
  background-color: var(--color-footer);
  padding: 24px 0;
}

.footer__content {
  color: var(--color-text);
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  font-size: 12px;
  display: grid;
}

.footer-column a {
  color: var(--color-text);
  margin-bottom: 6px;
  text-decoration: none;
  transition: color .3s;
  display: block;
}

.footer-column a:last-child {
  margin-bottom: 0;
}

.footer-column a:hover {
  color: var(--color-primary);
}

.footer-column span {
  display: block;
}

@media (width <= 768px) {
  .header__nav {
    flex-direction: column;
    gap: 16px;
    margin-top: 12px;
  }

  .footer__content {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .form {
    padding: 24px;
  }

  .confirmation-message {
    padding: 40px 16px;
  }
}

@media (width <= 480px) {
  .form__title {
    font-size: 20px;
  }

  .button {
    text-align: center;
    width: 100%;
  }
}
